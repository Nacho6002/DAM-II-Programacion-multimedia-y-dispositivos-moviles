<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buscar en OpenWeather"
        android:textSize="22sp"
        android:textColor="#000000"
        android:layout_marginBottom="20dp"/>

    <SearchView
        android:id="@+id/searchViewApi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="Escribe ciudad..."
        android:iconifiedByDefault="false"
        android:background="#F0F0F0"
        android:layout_marginBottom="30dp"/>

    <LinearLayout
        android:id="@+id/layoutResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FAFAFA"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tvNombreApi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="#000000"
            android:text="Nombre Ciudad"/>

        <ImageView
            android:id="@+id/imgIconoApi"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvTempApi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textColor="#000000"
            android:text="00°C"/>

        <TextView
            android:id="@+id/tvDescApi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#666666"
            android:text="descripción"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnAgregarLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AÑADIR A LA LISTA"/>
    </LinearLayout>

</LinearLayout>